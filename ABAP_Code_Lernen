        </textarea>
        <button onclick="runCode()">Code ausführen</button>
        <iframe id="output"></iframe>
    </div>

    <script>
        function runCode() {
            const code = document.getElementById('code-area').value;
            const iframe = document.getElementById('output');
            iframe.srcdoc = code;
        }
    </script>
</body>
</html>
